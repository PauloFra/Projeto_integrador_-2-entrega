# ---------------------------------------------------------------------------
# Patas Conectadas — variáveis de ambiente do backend
#
# Copie este arquivo para ".env" antes de subir o servidor:
#   Windows (PowerShell):  Copy-Item .env.example .env
#   Linux / macOS:         cp .env.example .env
# ---------------------------------------------------------------------------

# Porta HTTP da API
PORT=3333

# Ambiente de execução: development | test | production
NODE_ENV=development

# Caminho do arquivo SQLite (relativo à pasta backend/)
DATABASE_FILE=./data/patas.db

# Origens liberadas no CORS (separadas por vírgula)
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# Segredo usado para assinar os tokens de sessão (HMAC-SHA256).
# Em produção, gere um valor aleatório:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=patas-conectadas-poc-secret-trocar-em-producao

# Validade do token de sessão, em horas
AUTH_TOKEN_TTL_HOURS=12
