# ---------------------------------------------------------------------------
# Patas Conectadas — variáveis de ambiente do frontend
#
# Copie este arquivo para ".env" antes de subir o Vite:
#   Windows (PowerShell):  Copy-Item .env.example .env
#   Linux / macOS:         cp .env.example .env
#
# Observação: no Vite, só variáveis com o prefixo VITE_ chegam ao navegador.
# ---------------------------------------------------------------------------

# Caminho base das chamadas de API feitas pelo navegador.
# Mantenha "/api" para usar o proxy do Vite (recomendado em desenvolvimento).
VITE_API_URL=/api

# Endereço da API Node para onde o proxy do Vite encaminha "/api".
VITE_API_PROXY=http://localhost:3333
